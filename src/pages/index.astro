---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Trayectoria from '../components/Trayectoria.astro';
import Robotica from '../components/Robotica.astro';
import Stack from '../components/Stack.astro';
import SobreMi from '../components/SobreMi.astro';
import Destacados from '../components/Destacados.astro';
import Proyectos from '../components/Proyectos.astro';
import Servicios from '../components/Servicios.astro';
import Estadisticas from '../components/Estadisticas.astro';
import Certificaciones from '../components/Certificaciones.astro';
import Proceso from '../components/Proceso.astro';
import Idiomas from '../components/Idiomas.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header slot="header" />
  <Hero />
  <Stack />
  <SobreMi />
  <Trayectoria />
  <Robotica />
  <Destacados />
  <Proyectos />
  <Servicios />
  <Estadisticas />
  <Certificaciones />
  <Proceso />
  <Idiomas />
  <Contacto />
  <Footer slot="footer" />
</BaseLayout>
