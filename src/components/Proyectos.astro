---
import { proyectos } from '../data/perfil';
import ProyectoCard from './ProyectoCard.astro';

/**
 * Sección "Proyectos" — la lista completa.
 *
 * Aquí van TODOS los proyectos, los destacados incluidos: los tres destacados
 * tienen su propia sección más arriba y aquí se ven en igualdad con el resto.
 * La tarjeta es la misma (`ProyectoCard.astro`) con `variante="caso"`.
 *
 * La lista se presenta como carrusel horizontal con profundidad, sin rotación
 * y con avance automático que se pausa al interactuar. Cada tarjeta conserva
 * su caso completo.
 *
 */
---

<section class="section" id="proyectos">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">PROYECTOS</p>
      <h2 class="section__title">Todos los proyectos</h2>
    </div>

    <div class="project-carousel" data-project-carousel>
      <div class="project-carousel__controls">
        <div class="project-carousel__progress" aria-hidden="true">
          <span class="project-carousel__progress-fill" data-carousel-progress></span>
        </div>
        <div class="project-carousel__nav-row">
          <span class="project-carousel__label">ÍNDICE</span>
          <button
            class="project-carousel__nav project-carousel__nav--toggle"
            type="button"
            data-carousel-toggle
            aria-label="Pausar avance automático"
            aria-pressed="true"
          >
            Pausar
          </button>
          <button
            class="project-carousel__nav"
            type="button"
            data-carousel-prev
            aria-label="Proyecto anterior"
          >
            ←
          </button>
          <span class="project-carousel__count" data-carousel-count aria-live="polite">
            01 / {String(proyectos.length).padStart(2, '0')}
          </span>
          <button
            class="project-carousel__nav"
            type="button"
            data-carousel-next
            aria-label="Proyecto siguiente"
          >
            →
          </button>
        </div>
      </div>

      <div
        class="project-carousel__track"
        role="group"
        aria-label="Proyectos ordenados por impacto"
        tabindex="0"
        data-carousel-track
      >
        {
          proyectos.map((proyecto, i) => (
            <div class="project-carousel__slide" data-carousel-slide>
              <ProyectoCard proyecto={proyecto} indice={i + 1} variante="caso" />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
