---
import { sobreMi } from '../data/perfil';
---

<section class="section" id="sobre-mi">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">{sobreMi.eyebrow}</p>
      <h2 class="section__title">{sobreMi.titulo}</h2>
      <p class="section__subtitle">{sobreMi.subtitulo}</p>
    </div>

    <div class="about-grid" data-about-carousel>
      {
        sobreMi.items.map((item, indice) => (
          <article
            class:list={[
              'about-card',
              'reveal',
              {
                'about-card--lead': indice === 0,
                'about-card--interests': Boolean(item.intereses),
              },
            ]}
            style={`--about-index: ${indice};`}
            data-about-slide
          >
            <div class="about-card__heading">
              <span class="about-card__index" aria-hidden="true">
                {String(indice + 1).padStart(2, '0')}
              </span>
              <h3 class="about-card__title" id={`about-question-${indice + 1}`}>
                {item.pregunta}
                <span class="card-title-star" aria-hidden="true">★</span>
              </h3>
            </div>
            <div class="about-card__body">
              <p class:list={['about-card__text', indice === 0 && 'about-card__text--lead']}>
                {item.respuesta}
              </p>
              {item.intereses && (
                <ul class="tag-list about-card__tags">
                  {item.intereses.map((interes) => (
                    <li class="tag">{interes}</li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <div class="about-carousel__controls" data-about-controls hidden>
      <div class="about-carousel__progress" aria-hidden="true">
        <span class="about-carousel__progress-fill" data-about-progress></span>
      </div>
      <div class="about-carousel__nav">
        <span class="about-carousel__count" data-about-count aria-live="polite"></span>
        <button
          class="about-carousel__button about-carousel__button--toggle"
          type="button"
          data-about-toggle
          aria-label="Pausar avance automático"
          aria-pressed="true"
        >
          Pausar
        </button>
        <button
          class="about-carousel__button"
          type="button"
          data-about-prev
          aria-label="Pregunta anterior"
        >
          ←
        </button>
        <button
          class="about-carousel__button"
          type="button"
          data-about-next
          aria-label="Pregunta siguiente"
        >
          →
        </button>
      </div>
    </div>

    <aside class="about-value reveal">
      <p class="about-value__label">{sobreMi.valor.label}</p>
      <p class="about-value__text">{sobreMi.valor.texto}</p>
    </aside>
  </div>
</section>
