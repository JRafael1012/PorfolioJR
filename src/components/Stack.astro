---
import { stack } from '../data/perfil';
import { withBase } from '../paths';

// Tres fuentes de iconos, en este orden:
//   1. Simple Icons, que además permite teñir el SVG del color de acento.
//   2. Devicon, para lo que Simple Icons no tiene (Java, PowerShell, VS Code).
//   3. `icono`: un SVG guardado en public/img/logos/ (Windows, Copilot,
//      ChatGPT, AntiGravity y Canva). Pasa por withBase porque en GitHub
//      Pages el sitio vive bajo /<repositorio>/.
// El nombre siempre se escribe al lado, así el logo es decorativo: si el
// CDN falla o no hay conexión, el texto sigue diciendo qué es cada cosa.
const iconUrl = (slug?: string, di?: string, icono?: string) => {
  if (slug) return `https://cdn.simpleicons.org/${slug}/ffba08`;
  if (di) {
    return `https://cdn.jsdelivr.net/gh/devicons/devicon/icons/${di}/${di}-original.svg`;
  }
  if (icono) return withBase(`/${icono}`);
  return undefined;
};

const fila = (repetir: number) =>
  Array.from({ length: repetir }, (_, vuelta) =>
    stack.map((tech, indice) => ({ ...tech, clave: `${vuelta}-${indice}` }))
  );
---

<section class="section stack" id="stack">
  <div class="container">
    <div class="section__head stack__head">
      <div>
        <p class="eyebrow">STACK</p>
        <h2 class="section__title">Herramientas</h2>
        <p class="section__subtitle">
          Con lo que trabajo según el tipo de problema.
        </p>
      </div>

      <button
        class="marquee-toggle"
        type="button"
        data-marquee-toggle="stack"
        aria-pressed="false"
      >
        <span class="marquee-toggle__icon" aria-hidden="true">❚❚</span>
        <span data-marquee-toggle-label="stack">Pausar</span>
      </button>
    </div>
  </div>

  <div class="marquee" data-marquee="stack">
    <div class="marquee__track" data-marquee-track>
      {
        fila(2).map((copia, indice) => (
          <ul
            class="marquee__group"
            aria-hidden={indice === 1 ? 'true' : undefined}
          >
            {copia.map((tech) => {
              const url = iconUrl(tech.slug, tech.di, tech.icono);
              return (
                <li class="marquee__item">
                  {url && (
                    <img
                      class="marquee__logo"
                      src={url}
                      alt=""
                      width="30"
                      height="30"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <span class="marquee__name">{tech.nombre}</span>
                </li>
              );
            })}
          </ul>
        ))
      }
    </div>
  </div>
</section>
