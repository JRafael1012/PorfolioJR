---
import { stack } from '../data/perfil';
import { withBase } from '../paths';

// Tres fuentes de iconos, en este orden:
//   1. Simple Icons, que además permite teñir el SVG del color de acento.
//   2. Devicon, para lo que Simple Icons no tiene (Java, PowerShell, VS Code).
//   3. `icono`: un SVG guardado en public/img/logos/ (Windows). Pasa por
//      withBase porque en GitHub Pages el sitio vive bajo /<repositorio>/.
// El nombre siempre se escribe al lado, así el logo es decorativo: si el
// CDN falla o no hay conexión, el texto sigue diciendo qué es cada cosa.
// Cada lista se pinta dos veces: la segunda copia permite que el bucle
// translateX(-50%) reinicie sin hueco y queda oculta a lectores de pantalla.
const iconUrl = (slug?: string, di?: string, icono?: string) => {
  if (slug) return `https://cdn.simpleicons.org/${slug}/ffba08`;
  if (di) {
    return `https://cdn.jsdelivr.net/gh/devicons/devicon/icons/${di}/${di}-original.svg`;
  }
  if (icono) return withBase(`/${icono}`);
  return undefined;
};

const grupos = [
  {
    id: 'principal',
    etiqueta: 'Uso a diario',
    titulo: 'Con lo que trabajo',
    items: stack.filter((tech) => tech.nivel !== 'basico'),
  },
  {
    id: 'basico',
    etiqueta: 'Conocimientos básicos',
    titulo: 'En exploración',
    items: stack.filter((tech) => tech.nivel === 'basico'),
  },
];
---

<section class="section stack" id="stack">
  <div class="container">
    <div class="section__head stack__head">
      <div>
        <p class="eyebrow">STACK</p>
        <h2 class="section__title">Herramientas</h2>
        <p class="section__subtitle">
          Con lo que trabajo según el tipo de problema.
        </p>
      </div>
    </div>
  </div>

  {
    grupos.map((grupo) => (
      <div class:list={['stack-group', `stack-group--${grupo.id}`]}>
        <div class="container">
          <p class="stack-group__label">
            <span>{grupo.etiqueta}</span>
            <span>{grupo.titulo}</span>
          </p>
        </div>
        <div class="marquee">
          <div
            class="marquee__track"
            tabindex="0"
            role="group"
            aria-label={`${grupo.etiqueta}: ${grupo.titulo}. Enfoca esta cinta para detenerla.`}
          >
            {
              [0, 1].map((copia) => (
                <ul class="marquee__group" aria-hidden={copia === 1 ? 'true' : undefined}>
                  {
                    grupo.items.map((tech) => {
                      const url = iconUrl(tech.slug, tech.di, tech.icono);
                      return (
                        <li class="marquee__item">
                          {url && (
                            <img
                              class="marquee__logo"
                              src={url}
                              alt=""
                              width="30"
                              height="30"
                              loading="lazy"
                              decoding="async"
                            />
                          )}
                          <span class="marquee__name">{tech.nombre}</span>
                        </li>
                      );
                    })
                  }
                </ul>
              ))
            }
          </div>
        </div>
      </div>
    ))
  }
</section>
