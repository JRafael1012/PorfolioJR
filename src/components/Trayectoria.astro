---
import { experiencia } from '../data/perfil';
---

<section class="section" id="trayectoria">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">FORMACIÓN</p>
      <h2 class="section__title">Trayectoria</h2>
      <p class="section__subtitle">
        Técnico en Desarrollo de Software e Ingeniería de Sistemas en curso.
      </p>
    </div>

    <ol class="exp-list" data-timeline>
      {
        experiencia.map((item, indice) => (
          <li
            class:list={[
              'exp-item',
              'reveal',
              {
                'exp-item--technician':
                  item.puesto === 'Técnico en Desarrollo de Software',
                // El collage se mudó a la sección de Robótica en D28, junto con
                // los torneos que colgaban de él.
                'exp-item--collage': Boolean(
                  item.galeria?.length && !item.detalleEn,
                ),
              },
            ]}
          >
            <p class="exp-period">{item.periodo}</p>
            <div class="exp-detail">
              <h3>{item.puesto}</h3>
              <p class="exp-company">{item.empresa}</p>

              {item.detalleEn ? (
                /* Bloque con detalle propio: aquí queda la línea y un enlace a
                   la sección que lo desarrolla. Los logros, el stack, la
                   galería y los torneos los lee esa sección desde los mismos
                   datos, así que no se repite nada. */
                <p class="exp-summary">{item.linea ?? item.resumen}</p>
                <a class="exp-detail__more" href={`#${item.detalleEn}`}>
                  Ver la sección de Robótica
                  <span class="exp-detail__arrow" aria-hidden="true">→</span>
                </a>
              ) : (
                <>
                  <p class="exp-summary">{item.resumen}</p>
                  <ul class="exp-achievements">
                    {item.logros.map((logro) => (
                      <li>{logro}</li>
                    ))}
                  </ul>
                  <ul class="tag-list">
                    {item.stack.map((tech) => (
                      <li class="tag">{tech}</li>
                    ))}
                  </ul>
                </>
              )}
              {item.puesto === 'Técnico en Desarrollo de Software' && (
                <aside class="exp-project" aria-label="Proyecto final del SENA">
                  <span class="exp-project__label">Proyecto final · SENA</span>
                  <strong class="exp-project__name">Finovateh</strong>
                </aside>
              )}
            </div>
            {item.puesto === 'Técnico en Desarrollo de Software' && (
              <div
                class="credential-gallery"
                data-credential-gallery
                aria-label="Fotos de la graduación técnica"
              >
                <div class="credential-gallery__slides">
                  <figure
                    class="credential-slide is-active"
                    data-credential-slide
                    aria-hidden="false"
                  >
                    <div class="credential-slot credential-slot--diploma">
                      <span class="credential-slot__index">01 / 02</span>
                      <svg
                        class="credential-slot__icon"
                        viewBox="0 0 48 48"
                        fill="none"
                        aria-hidden="true"
                      >
                        <rect
                          x="9"
                          y="6"
                          width="30"
                          height="36"
                          rx="2"
                          stroke="currentColor"
                          stroke-width="1.5"
                        />
                        <path
                          d="M16 16h16M16 22h16M16 28h8"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                        />
                        <circle
                          cx="31"
                          cy="33"
                          r="4"
                          stroke="currentColor"
                          stroke-width="1.5"
                        />
                      </svg>
                      <span class="credential-slot__title">Diploma técnico</span>
                      <code class="credential-slot__path">
                        public/img/diploma-tecnico.jpg
                      </code>
                    </div>
                    <figcaption class="credential-caption">
                      <span>Certificación</span>
                      <span>Diploma</span>
                    </figcaption>
                  </figure>

                  <figure
                    class="credential-slide"
                    data-credential-slide
                    aria-hidden="true"
                  >
                    <div class="credential-slot credential-slot--ceremony">
                      <span class="credential-slot__index">02 / 02</span>
                      <svg
                        class="credential-slot__icon"
                        viewBox="0 0 48 48"
                        fill="none"
                        aria-hidden="true"
                      >
                        <rect
                          x="5"
                          y="10"
                          width="38"
                          height="28"
                          rx="2"
                          stroke="currentColor"
                          stroke-width="1.5"
                        />
                        <circle
                          cx="24"
                          cy="21"
                          r="5"
                          stroke="currentColor"
                          stroke-width="1.5"
                        />
                        <path
                          d="M14 34c1.8-4 5.1-6 10-6s8.2 2 10 6"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                        />
                      </svg>
                      <span class="credential-slot__title">Entrega del diploma</span>
                      <code class="credential-slot__path">
                        public/img/entrega-diploma.jpg
                      </code>
                    </div>
                    <figcaption class="credential-caption">
                      <span>El momento</span>
                      <span>Graduación</span>
                    </figcaption>
                  </figure>
                </div>
              </div>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>
