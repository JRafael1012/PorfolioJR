---
/**
 * Una tarjeta de proyecto.
 *
 * Todos los bloques son condicionales: se dibuja solo el campo que exista en
 * los datos. Un dato que falta **no se inventa ni se disimula**, simplemente
 * no sale. Ver D21 en plans/plan_midegs_completo.md.
 *
 * El hueco de la imagen se reservation SIEMPRE, tenga foto o no: así la
 * tarjeta mantiene su altura y no da saltos cuando se añada la captura.
 */
import type { Proyecto } from '../data/perfil';
import { withBase } from '../paths';

interface Props {
  proyecto: Proyecto;
  destacada?: boolean;
  indice?: number;
  variante?: 'resumen' | 'caso';
}

const {
  proyecto,
  destacada = false,
  indice,
  variante = 'caso',
} = Astro.props;
const esResumen = variante === 'resumen';

/**
 * `withBase()` solo antepone el prefijo a rutas que empiezan por `/`. Sin esto,
 * `imagen: 'img/proyectos/x.webp'` se emitiría como ruta relativa y en GitHub
 * Pages resolvería a `usuario.github.io/img/...`, sin el `/PorfolioJR`:
 * un 404. Se acepta las dos formas, con y sin barra inicial.
 */
const imagenSrc = proyecto.imagen
  ? withBase(proyecto.imagen.startsWith('/') ? proyecto.imagen : `/${proyecto.imagen}`)
  : undefined;
const nombreArchivo = proyecto.titulo
  .toLowerCase()
  .normalize('NFD')
  .replace(/[̀-ͯ]/g, '')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '');
const rutaCaptura = `/img/proyectos/${nombreArchivo}.webp`;
const stackPrincipal = proyecto.stack?.slice(0, 3) ?? [];
const tecnologiasVisibles =
  destacada || !esResumen ? (proyecto.stack ?? []) : stackPrincipal;
const etiquetaTecnologias = destacada ? 'Lenguajes y tecnologías' : 'Tecnologías';
const senaEnEstado = proyecto.estado?.includes('SENA') ? 'SENA' : undefined;
const distincionResumen = proyecto.distincion
  ? [proyecto.distincion.split(' · ')[0], senaEnEstado].filter(Boolean).join(' · ')
  : undefined;

const hayProblema = Boolean(proyecto.problema);
const hayResto = Boolean(
  proyecto.funcionalidades?.length ||
    proyecto.participacion ||
    proyecto.seguridad?.length ||
    proyecto.arquitectura?.length ||
    proyecto.calidad?.length ||
    proyecto.bitacora?.length,
);
const detallesId = `proyecto-detalles-${nombreArchivo}`;
---

<article
  class:list={[
    'card',
    'project-card',
    esResumen ? 'project-card--resumen' : 'project-card--caso',
    { 'project-card--wide': destacada },
  ]}
>
  <div class="project-card__media">
    {
      imagenSrc ? (
        <img
          class="project-card__img"
          src={imagenSrc}
          alt={`Captura de ${proyecto.titulo}`}
          loading={destacada ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <div class="project-card__slot" aria-hidden="true" data-imagen-path={rutaCaptura}>
          <span class="project-card__slot-mark">{proyecto.stack?.[0] ?? 'JR'}</span>
          <span class="project-card__slot-text">Sin imagen publicada</span>
        </div>
      )
    }
  </div>

  <div class="project-card__body">
    <div class="project-card__head">
      {indice && (
        <span class="project-card__index">
          {String(indice).padStart(2, '0')}
        </span>
      )}
      <h3 class="project-card__title">
        {proyecto.titulo}
        <span class="card-title-star" aria-hidden="true">★</span>
      </h3>
      {proyecto.estado && <p class="project-card__estado">{proyecto.estado}</p>}
    </div>

    {proyecto.descripcion && <p class="project-card__desc">{proyecto.descripcion}</p>}

    {
      proyecto.distincion && (
        <p
          class:list={[
            'project-card__honor',
            { 'project-card__honor--resumen': esResumen },
          ]}
        >
          <span class="project-card__honor-mark" aria-hidden="true">★</span>
          {esResumen ? distincionResumen : proyecto.distincion}
        </p>
      )
    }

    {
      tecnologiasVisibles.length > 0 && (
        <div class="project-card__block">
          <p class="project-card__label">{etiquetaTecnologias}</p>
          <ul class="tag-list">
            {tecnologiasVisibles.map((tech) => (
              <li class="tag">{tech}</li>
            ))}
          </ul>
        </div>
      )
    }

    {
      !esResumen && (hayProblema || hayResto) && (
        <div class="project-card__details-body project-card__details-body--abierto">
          {
            hayProblema && (
              <div class="project-card__block">
                <p class="project-card__label">Problema que resuelve</p>
                <p class="project-card__text">{proyecto.problema}</p>
              </div>
            )
          }

          {
            hayResto && (
              <div class="project-card__more" data-project-more>
                <div
                  class="project-card__more-inner"
                  id={detallesId}
                  data-project-more-inner
                >
                  {
                    proyecto.funcionalidades && proyecto.funcionalidades.length > 0 && (
                      <div class="project-card__block">
                        <p class="project-card__label">Funcionalidades</p>
                        <ul class="project-card__features">
                          {proyecto.funcionalidades.map((funcionalidad) => (
                            <li>{funcionalidad}</li>
                          ))}
                        </ul>
                      </div>
                    )
                  }

                  {
                    proyecto.participacion && (
                      <div class="project-card__block">
                        <p class="project-card__label">Arquitectura y mi participación</p>
                        <p class="project-card__text">{proyecto.participacion}</p>
                      </div>
                    )
                  }

                  {
                    proyecto.seguridad && proyecto.seguridad.length > 0 && (
                      <div class="project-card__block">
                        <p class="project-card__label">Seguridad y Buenas Prácticas</p>
                        <ul class="project-card__features">
                          {proyecto.seguridad.map((practica) => (
                            <li>{practica}</li>
                          ))}
                        </ul>
                      </div>
                    )
                  }

                  {
                    proyecto.arquitectura && proyecto.arquitectura.length > 0 && (
                      <div class="project-card__block">
                        <p class="project-card__label">Arquitectura y Base de Datos</p>
                        <ul class="project-card__features">
                          {proyecto.arquitectura.map((decision) => (
                            <li>{decision}</li>
                          ))}
                        </ul>
                      </div>
                    )
                  }

                  {
                    proyecto.calidad && proyecto.calidad.length > 0 && (
                      <div class="project-card__block">
                        <p class="project-card__label">Calidad y Pruebas (QA)</p>
                        <ul class="project-card__features">
                          {proyecto.calidad.map((prueba) => (
                            <li>{prueba}</li>
                          ))}
                        </ul>
                      </div>
                    )
                  }

                  {
                    proyecto.bitacora && proyecto.bitacora.length > 0 && (
                      <div class="project-card__block">
                        <p class="project-card__label">Retos Técnicos Resueltos (Bitácora de ingeniería)</p>
                        <ul class="project-card__features">
                          {proyecto.bitacora.map((reto) => (
                            <li>{reto}</li>
                          ))}
                        </ul>
                      </div>
                    )
                  }
                </div>
              </div>
            )
          }

          {
            hayResto && (
              <button
                class="project-card__more-btn"
                type="button"
                data-project-more-toggle
                aria-expanded="false"
                aria-controls={detallesId}
              >
                <span data-project-more-label>Ver detalles</span>
                <span class="project-card__more-icon" aria-hidden="true" data-project-more-icon>+</span>
              </button>
            )
          }
        </div>
      )
    }

    {
      (proyecto.demo || proyecto.demoPendiente || proyecto.repositorio) && (
        <div class="project-card__actions">
          {
            proyecto.demo ? (
              <a
                class="project-card__btn"
                href={proyecto.demo}
                target="_blank"
                rel="noopener noreferrer"
              >
                {proyecto.demoEtiqueta ?? 'Ver Demo / Video'}
                <span class="project-card__btn-arrow" aria-hidden="true">↗</span>
              </a>
            ) : proyecto.demoPendiente ? (
              <>
                {/* TODO: pega aquí la URL de Render/Railway/YouTube en `demo` y quita `demoPendiente`. */}
                <span class="project-card__btn project-card__btn--pendiente" aria-disabled="true">
                  Demo no publicada
                </span>
              </>
            ) : null
          }
          {proyecto.repositorio && (
            <a
              class="project-card__btn"
              href={proyecto.repositorio}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
              <span class="project-card__btn-arrow" aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      )
    }
  </div>
</article>